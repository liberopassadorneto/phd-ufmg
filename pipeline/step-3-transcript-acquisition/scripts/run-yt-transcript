#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"

cd "$repo_root/pipeline/step-3-transcript-acquisition"
export S3_BUCKET=youtube-transcripts
exec "$repo_root/pipeline/bootstrap/with-shared-env" uv run --frozen --project . yt-transcript "$@"
