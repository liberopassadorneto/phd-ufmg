FROM python:3.14-slim

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --locked --no-dev

COPY seed_data ./seed_data
COPY scripts/bootstrap_compose.py ./scripts/bootstrap_compose.py

CMD ["uv", "run", "--no-sync", "python", "scripts/bootstrap_compose.py"]
